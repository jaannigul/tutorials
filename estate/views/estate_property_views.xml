<odoo>
    <record id= "estate_search_bar" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="state"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <filter name="filter_available" string="Available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <group expand="1" string="Group By">
                    <filter name="group_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button name="action_sold_button" type="object" string="Sold" invisible="state == 'sold' or state == 'cancelled'"/>

                    <button name="action_cancelled_button" type="object" string="Cancel" invisible="state == 'sold' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <field name="property_tag_ids" widget="many2many_tags" nolabel="1"/>
                    <group>
                        <group>
                            <group>
                                
                                <field name="property_type_id" options="{'no_create': True, 'no_edit': True}"/>
                                <field name="date_availability"/>
                                <field name="postcode"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="best_price"/>
                                <field name="selling_price"/>
                            </group>
                        </group>
                        <notebook>
                            
                            <page string="Details">
                                <group colspan="1">
                                <label for="description">Description</label>
                                <field name="description" style="width: 300px;" nolabel="1"/>
                                <field name="bedrooms" style="width: 300px;"/>
                                <field name="living_area" style="width: 300px;"/>
                                <field name="garden" style="width: 300px;"/>
                                <field name="garden_area" style="width: 300px;" invisible="not garden"/>
                                <field name="total_area" style="width: 300px;"/>
                                <field name="garden_orientation" style="width: 300px;" invisible="not garden"/>
                                <field name="garage" style="width: 300px;"/>
                                <field name="active" style="width: 300px;"/>
                                
                                
                                </group>
                            </page>

                            <page string="Offers">
                                <field name="offer_ids">
                                    
                                <list editable="bottom">
                                <!--bug-->
                                    <field name="price" style="width: 300px;" readonly="['|', ('state', '=', 'offer_accepted'), ('state', '=', 'sold'), ('state', '=', 'cancelled')]"/>
                                    <field name="partner_id" style="width: 300px;" colspan="1" readonly="['|', ('state', '=', 'offer_accepted'), ('state', '=', 'sold'), ('state', '=', 'cancelled')]" />
                                    <field name="validity" style="width: 300px;" readonly="['|', ('state', '=', 'offer_accepted'), ('state', '=', 'sold'), ('state', '=', 'cancelled')]"/>
                                    <field name="date_deadline" style="width: 300px;" readonly="['|', ('state', '=', 'offer_accepted'), ('state', '=', 'sold'), ('state', '=', 'cancelled')]"/>
                                    <button name="action_accept_offer" type="object" title="Accept" icon="fa-check" invisible="status == 'accepted' or status == 'refused'"/>
                                    <button name="action_refuse_offer" type="object" title="refuse" icon="fa-times" invisible="status == 'accepted' or status == 'refused'"/>
                                    <field name="status" style="width: 300px;" readonly="1"/>
                                
                                </list>
                                </field>
                            </page>

                            <page string="Other info">
                                <group>
                                
                                    <field name="buyer_id" style="width: 300px;" readonly="1"/>
                                    <field name="salesperson_id" style="width: 300px;"/>
                                </group>
                            </page>
                        </notebook>
                    </group>
                    
                </sheet>
            </form>
        </field>

    </record>

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Estate Properties">
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="date_availability"/>
            </list>
        </field>

    </record>
</odoo>